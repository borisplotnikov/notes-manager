{
  "name": "notes-manager-root",
  "private": true,
  "version": "1.0.0",
  "main": "index.js",
  "repository": "https://github.com/borisplotnikov/notes-manager.git",
  "author": "Boris Plotnikov <boriswo@gmail.com>",
  "license": "MIT",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "packageManager": "yarn@4.15.0",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3"
  },
  "scripts": {
    "dev:frontend": "yarn workspace @notes-manager/frontend dev",
    "dev:backend": "yarn workspace @notes-manager/backend dev",
    "dev": "concurrently \"yarn dev:frontend\" \"yarn dev:backend\"",
    "build:frontend": "yarn workspace @notes-manager/frontend build",
    "build:backend": "yarn workspace @notes-manager/backend build",
    "build": "concurrently \"yarn build:frontend\" \"yarn build:backend\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "test": "echo 'No tests configured yet.'"
  },
  "lint-staged": {
    "**/*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  }
}
