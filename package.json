{
  "name": "notes-manager-root",
  "private": true,
  "version": "1.0.0",
  "main": "index.js",
  "repository": "https://github.com/borisplotnikov/notes-manager.git",
  "author": "Boris Plotnikov <boriswo@gmail.com>",
  "license": "MIT",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "packageManager": "yarn@4.15.0+sha512.07ec708ac11e2eaa4ea2b04cfbb272812f7e74a753f1595eaef4486c663a98306a30cca3e6fc40f7a0b168dcfb3a2490b6a5e0501e20fb69cc36f563dd161c53",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3"
  },
  "scripts": {
    "dev:frontend": "yarn workspace @notes-manager/frontend dev",
    "dev:backend": "yarn workspace @notes-manager/backend dev",
    "dev": "concurrently \"yarn dev:frontend\" \"yarn dev:backend\"",
    "build:frontend": "yarn workspace @notes-manager/frontend build",
    "build:backend": "yarn workspace @notes-manager/backend build",
    "build": "yarn build:backend && yarn build:frontend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  }
}
